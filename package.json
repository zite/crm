{
  "name": "crm",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zitejs": "0.9.115"
  },
  "scripts": {
    "dev": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/crm dev'",
    "dev:crm": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/crm dev'",
    "dev:crm-pages": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/crm-pages dev'",
    "generate": "zitejs generate",
    "check": "zitejs check",
    "build": "yarn workspace @project/crm build"
  }
}
